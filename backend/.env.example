# Configuración de EDUmind Quiz — copiar a .env y rellenar
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Base de datos (SQLite por defecto, junto al backend)
DATABASE_URL=sqlite:///./edumind_quiz.db
# Alta de docentes por Internet. Cerrada por defecto: las cuentas se crean poniéndolo
# a true de forma temporal o dando de alta al docente a mano. Nunca dejarlo abierto en producción.
ALLOW_TEACHER_REGISTRATION=false
